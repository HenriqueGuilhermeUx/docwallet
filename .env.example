# DocWallet - Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores.
# No Netlify, configure em Site settings > Environment variables.

# Supabase
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Blockchain / carteira EVM
# Padrão: Polygon mainnet
VITE_DOCWALLET_CHAIN_ID=137
VITE_DOCWALLET_NETWORK_NAME=Polygon
VITE_DOCWALLET_RPC_URL=https://polygon-rpc.com
VITE_DOCWALLET_EXPLORER_URL=https://polygonscan.com/tx
VITE_DOCWALLET_NATIVE_NAME=POL
VITE_DOCWALLET_NATIVE_SYMBOL=POL
VITE_DOCWALLET_NATIVE_DECIMALS=18

# Carteira recebedora das cobranças cripto
# Use uma carteira sua/controlada por você.
VITE_DOCWALLET_TREASURY_ADDRESS=0xSUA_CARTEIRA_RECEBEDORA

# Valor cobrado por validação blockchain em moeda nativa da rede configurada
VITE_DOCWALLET_NOTARIZATION_PRICE_NATIVE=0.01
